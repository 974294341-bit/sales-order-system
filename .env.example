# 销售订货系统配置示例（程序只读取「环境变量」，不解析本文件；run.bat / run.sh 已内置默认值）
# 如需覆盖，在启动前用 set（Windows）或 export（bash）设置即可。

APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
APP_DATA_DIR=data
APP_WEB_DIR=web
APP_ACCESS_TOKEN_SECONDS=1800
APP_REFRESH_TOKEN_SECONDS=604800
APP_JWT_SECRET=dev-only-change-me-32bytes-min
APP_SEED_DEMO_DATA=true
APP_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# 业务框架优化相关
APP_RUSH_MONTHLY_LIMIT=5
APP_SLA_ESCALATE=true
